<?xml version="1.0" encoding="utf-8"?>
<!--
  Source manifest of the template. It is only used to build the template APK; tools/make_template.py decodes the
  BUILT manifest and writes app/src/main/assets/java/manifest.xml with these attributes turned into placeholders:
    versionCode -> %1$s, versionName -> %2$s, package -> %3$s, application label -> %4$s, screenOrientation -> %5$s
  (the values below are just valid dummies). Component names stay com.star4droid.template.*.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <application
        android:name="com.star4droid.template.Star2dApp"
        android:allowBackup="true"
        android:icon="@drawable/icon"
        android:label="TPL_APP_LABEL"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.star4droid.template.LoadingScreen"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.star4droid.template.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape" />
        <activity
            android:name="com.star4droid.template.DebugActivity"
            android:exported="true"
            android:screenOrientation="landscape" />
    </application>
</manifest>
